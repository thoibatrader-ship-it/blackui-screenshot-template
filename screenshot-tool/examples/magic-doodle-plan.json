{
 "version": 1,
 "entry": "app.html",
 "settleMs": 600,
 "devices": [
  {
   "id": "phone",
   "width": 360,
   "height": 720,
   "scale": 3,
   "mobile": true
  },
  {
   "id": "tablet",
   "width": 1280,
   "height": 800,
   "scale": 2,
   "mobile": true
  }
 ],
 "screens": [
  {
   "key": "p-letter",
   "label": "Letter",
   "devices": [
    "phone"
   ],
   "steps": [
    {
     "click": "#menuBtn"
    },
    {
     "click": "#guideSwitch"
    },
    {
     "click": "#guideGrid button:nth-of-type(1)"
    },
    {
     "click": "#toolbar [data-action=hide]"
    }
   ]
  },
  {
   "key": "p-animal",
